{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c17:plugin-catalog:1",
  "title": "C17 辅助分发目录",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apiVersion", "plugins"],
  "properties": {
    "schemaVersion": {"const": 1},
    "apiVersion": {"const": 1},
    "name": {"type": "string", "maxLength": 4096},
    "description": {"type": "string", "maxLength": 4096},
    "updatedAt": {"type": "string", "maxLength": 4096},
    "readmeUrl": {"type": "string", "maxLength": 4096},
    "changesUrl": {"type": "string", "maxLength": 4096},
    "plugins": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "versionCode", "apiVersion", "file", "sha256", "size"],
        "properties": {
          "id": {"type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "version": {"type": "string", "minLength": 1, "maxLength": 32},
          "versionCode": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "apiVersion": {"const": 1},
          "description": {"type": "string", "maxLength": 1024},
          "author": {"type": "string", "maxLength": 80},
          "capabilities": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["settings", "systemui"]}},
          "file": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[a-z0-9_.-]+(?:/[a-z0-9_.-]+)*\\.zip$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 1048576}
        }
      }
    }
  }
}
