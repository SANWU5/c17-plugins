{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c17:plugin-manifest:1",
  "title": "C17 API 1/2 ZIP plugin.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "versionCode", "apiVersion", "entry"],
  "properties": {
    "id": {"type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {"type": "string", "minLength": 1, "maxLength": 32},
    "versionCode": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "apiVersion": {"enum": [1, 2]},
    "description": {"type": "string", "maxLength": 1024},
    "author": {"type": "string", "maxLength": 80},
    "capabilities": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["settings", "systemui", "runtime"]}},
    "entry": {"type": "string", "minLength": 4, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])(?!.*//).+\\.js$"},
    "minimumHost": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "features": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "maxLength": 80, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}},
    "usage": {"type": "string", "maxLength": 4096},
    "scopes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:android|[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+)$", "maxLength": 240}},
    "nativeSettings": {"type": "object", "additionalProperties": false, "required": ["dex", "className"], "properties": {"dex": {"type": "string", "minLength": 4, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[a-zA-Z0-9_./-]+\\.(?:dex|jar)$"}, "className": {"type": "string", "maxLength": 240, "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*(?:\\.[a-zA-Z_$][a-zA-Z0-9_$]*)+$"}}},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {"type": "string", "minLength": 4, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])(?!.*//).+\\.js$"},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "oneOf": [
        {"required": ["entry"], "not": {"required": ["source"]}},
        {"required": ["source"], "not": {"required": ["entry"]}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"apiVersion": {"const": 1}}, "required": ["apiVersion"]}, "then": {"properties": {"entry": {"maxLength": 128}, "capabilities": {"maxItems": 2, "items": {"enum": ["settings", "systemui"]}}}, "not": {"anyOf": [{"required": ["runtime"]}, {"required": ["nativeSettings"]}]}}},
    {"if": {"properties": {"apiVersion": {"const": 2}}, "required": ["apiVersion"]}, "then": {"required": ["runtime", "capabilities"], "properties": {"capabilities": {"contains": {"const": "runtime"}}}}}
  ],
  "$comment": "minimumHost/features/usage/scopes、控件分组及 nativeSettings 为 code210 起的可选展示与能力契约；目录仍使用原有分发元数据。scopes 不授予权限或创建跨进程运行环境。宿主另查 NUL、路径与 manifest/真实描述一致性。"
}
